# 책장 한켠 서버 환경변수. 카카오 키가 비어 있으면 가짜 도서로 뜬다.
PORT=8080
# 필수(Postgres). postgres://, postgresql://, jdbc:postgresql:// 및 KoDeploy의 postgresql+psycopg2:// 형식을 받는다.
DATABASE_URL=postgres://user:pass@host:5432/chaekjang?sslmode=disable

# 운영 사진 및 계정 삭제 기록: R2 S3 호환 버킷 (list/read/write/delete 권한 필요)
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# YES24 Developers API 키(책 검색·ISBN 조회. https://developers.yes24.com/my). 있으면 카카오보다 먼저 쓰고 쪽수·판형(mm)까지 받는다.
# 서버에만 둔다(앱 번들·EXPO_PUBLIC_*에 넣지 않는다). 약관: 앱에 출처(YES24)와 상품 페이지 링크를 함께 보인다.
YES24_API_KEY=
# 카카오 REST API 키(책 검색, YES24 키가 없을 때)
KAKAO_REST_KEY=
# 카카오 로그인: 콘솔 'REST API 키 > 클라이언트 시크릿(카카오 로그인)' 코드, 리다이렉트 URI는 PUBLIC_BASE_URL + /auth/kakao/callback 으로 등록
KAKAO_CLIENT_SECRET=
# 로그인만 구성할 때 사용. 도서 검색용 KAKAO_REST_KEY와 분리하여 검색 제공자를 바꾸지 않는다.
KAKAO_LOGIN_REST_KEY=
# Server only: authenticates Kakao unlink webhook and disconnects deleted accounts.
# Login remains disabled until both are configured. Never include in EXPO_PUBLIC_*.
KAKAO_ADMIN_KEY=
KAKAO_APP_ID=1604236
# Google 웹 OAuth 클라이언트. 서버에만 저장. 콜백: PUBLIC_BASE_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_BASE_URL=https://covebook.kodeploy.com

# LLM 키 여러 개: 쉼표로 구분, 적은 순서대로 먼저 쓴다.
# AIza...는 Gemini, sk-...는 GPT로 자동 판별. 형식이 다르면 gemini:키 / openai:키 로 적는다.
LLM_KEYS=
# 제공자별 모델 이름. 비어 있으면 그 제공자 키는 쓰지 않는다(배포 전 콘솔에서 확인해 적기).
GEMINI_MODEL=
OPENAI_MODEL=

# 캐시 갱신 주기(카카오 운영정책: 캐시는 최신 데이터로 유지)
BOOKS_CACHE_TTL=720h
SEARCH_CACHE_TTL=10m
