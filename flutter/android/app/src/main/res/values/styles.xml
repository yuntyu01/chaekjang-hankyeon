<?xml version="1.0" encoding="utf-8"?>
<!-- 지금 앱처럼 다크 모드에서도 흰 시작 화면·흰 바탕(앱은 밝은 화면만 있다) -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splashscreen_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- 키보드·리모컨 입력으로 터치 모드가 풀리면 안드로이드가 화면 전체(FlutterView)에 기본 포커스 테두리(연두색)를 그린다: 끈다(포커스 표시는 Flutter가 그린다) -->
        <item name="android:defaultFocusHighlightEnabled">false</item>
    </style>
</resources>
